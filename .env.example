# Ollama Configuration
# URL of the Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Vision model to use for image analysis
OLLAMA_MODEL=qwen3-vl:30b

# Timeout for Ollama API requests (in seconds)
OLLAMA_TIMEOUT=120

# Image Processing Configuration
# Path to folder containing images to process
IMAGE_FOLDER=/home/user/Pictures

# Failure Handling
# Number of consecutive failures allowed before aborting
# (aborting assumes Ollama is down or model is broken)
MAX_CONSECUTIVE_FAILURES=5
